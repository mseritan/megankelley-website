---
import Layout from '../../layouts/Layout.astro';
import { portfolio } from '../../data/portfolio.js';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portfolio/**/*.png', { eager: true });

function getCoverImage(category: { folder: string; cover: string }) {
    const path = `/src/assets/portfolio/${category.folder}/${category.cover}`;
    return images[path].default;
}
---
<Layout title="Portfolio" wide>
    <h1>Portfolio</h1>
    <p class="intro">In addition to my scientific interests, I am also interested in data visualization and art. Click on any of the categories below to see samples of my work.</p>
    {portfolio.map((supercategory) => (
        <div>
            <h2>{supercategory.supercategoryTitle}</h2>
            <div class="category-grid">
                {supercategory.categories.map((category) => {
                    const cover = getCoverImage(category);
                    return (
                        <a href={`/portfolio/${category.slug}`} class="category-card">
                            <div class="cover-wrapper">
                                <img src={cover.src} width={cover.width} height={cover.height} alt={category.title} />
                            </div>
                            <p>{category.title}</p>
                        </a>
                    );
                })}
            </div>
        </div>
    ))}
</Layout>

<style>
    .intro {
        max-width: 600px;
        margin: 0 auto 2.5rem;
    }
    .category-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin: 0 0 2.5rem;
    }
    .cover-wrapper {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: 8px;
    }
    .cover-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
    }
    .category-card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 8px;
        margin: 0;
    }
    .category-card p {
        margin: 0.5rem 0 0;
        font-weight: 600;
    }
</style>